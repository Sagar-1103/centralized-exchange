generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String @id      @default(uuid())
  username        String @unique
  hashedPassword  String
}

model Market {
  id        Int     @id       @default(autoincrement())
  name      String  @unique
  symbol    String  @unique
  decimals  Int
}